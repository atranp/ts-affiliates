generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  AFFILIATE
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE
  PENDING
  REJECTED
}

enum CommissionStatus {
  PENDING
  UNPAID
  PAID
  REJECTED
}

enum LedgerEntryType {
  DIRECT
  OVERRIDE
  BONUS
  ADJUSTMENT
}

enum DealRuleType {
  REVENUE_OVERRIDE
  COMMISSION_OVERRIDE
  BONUS
}

enum DealBasis {
  ORDER_REVENUE
  RECRUIT_COMMISSION
  FIXED
}

enum PayoutSchedule {
  WEEKLY_MONDAY
  BIWEEKLY
  MONTHLY
}

enum PayoutBatchStatus {
  DRAFT
  PROCESSING
  COMPLETED
}

enum PayoutSource {
  PLATFORM
  SLICEWP
}

/// Whether a payout batch has been reflected back into SliceWP.
///
/// The batch commits locally before the settle call is made, because an HTTP
/// call cannot be held inside the database transaction and unwinding a
/// committed payout is worse than recording that the write-back is outstanding.
/// So the two systems are briefly, knowably out of step, and this is the field
/// that says so.
enum PayoutWriteBackStatus {
  /// Nothing to settle. Either the batch is overrides only — those are
  /// platform-computed and have no SliceWP commission behind them — or it
  /// predates write-back and was settled by hand in SliceWP.
  NOT_REQUIRED
  /// Committed locally, not yet accepted by SliceWP.
  PENDING
  SETTLED
  /// The settle call failed. Safe to retry: the batch id is the idempotency key.
  FAILED
}

model Profile {
  id                 String     @id @db.Uuid
  email              String     @unique
  name               String
  role               Role       @default(AFFILIATE)
  affiliateId        String?    @unique
  affiliate          Affiliate? @relation(fields: [affiliateId], references: [id])
  mustChangePassword Boolean    @default(false)
  portalDisabledAt   DateTime?
  lastSignInAt       DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String   @db.Uuid
  action      String
  affiliateId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([affiliateId])
}

model Affiliate {
  id                 String          @id @default(cuid())
  slicewpId          Int             @unique
  email              String
  paymentEmail       String?
  displayName        String?
  status             AffiliateStatus @default(PENDING)
  commissionRate     Decimal?        @db.Decimal(5, 2)
  /// Vanity referral slug, e.g. "PGFit" in /aff/PGFit/. Lives in SliceWP's
  /// affiliate meta rather than its REST payload, so it arrives via the bridge.
  customSlug         String?
  /// The affiliate's actual referral link, built by WordPress. Stored rather
  /// than assembled here because the format depends on SliceWP settings
  /// (`affiliate_keyword`, `friendly_affiliate_url`) that this app does not own.
  referralUrl        String?
  storeCreditBalance Decimal?        @db.Decimal(12, 2)
  /// Also affiliate meta, and also invisible to SliceWP's REST payload. Mirrored
  /// only so the portal's Settings tab can show what is currently set.
  website            String?
  parentSlicewpId    Int?
  parentAffiliateId  String?
  parentAffiliate    Affiliate?      @relation("AffiliateTree", fields: [parentAffiliateId], references: [id], onDelete: SetNull)
  childAffiliates    Affiliate[]     @relation("AffiliateTree")
  syncedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  profile             Profile?
  commissions         Commission[]
  ledgerEntries       LedgerEntry[]     @relation("AffiliateLedger")
  sourceLedgerEntries LedgerEntry[]     @relation("SourceAffiliateLedger")
  sponsorRules        DealRule[]        @relation("SponsorRules")
  sourceRules         DealRule[]        @relation("SourceRules")
  payoutBatchItems    PayoutBatchItem[]
  slicewpPayments     SlicewpPayment[]
  managedTeams        Team[]            @relation("SponsorTeams")
  visits              Visit[]
  coupons             AffiliateCoupon[]

  @@index([parentAffiliateId])
  @@index([email])
}

/// A referral link click, mirrored from SliceWP.
///
/// By far the largest table here — roughly thirty clicks per commission, and
/// unlike commissions it grows whether or not anyone buys anything. Synced
/// incrementally against a date watermark rather than refetched, and indexed on
/// (affiliateId, occurredAt) because every question asked of it is "this
/// affiliate, this period".
///
/// Deliberately omits the visitor IP address that SliceWP stores. The affiliate
/// portal never displays it, so mirroring it would copy personal data into a
/// second system for no feature. SliceWP still has it if that ever changes.
model Visit {
  id                  String    @id @default(cuid())
  slicewpId           Int       @unique
  affiliateId         String
  affiliate           Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  landingUrl          String?
  referrerUrl         String?
  /// Set when the click went on to earn a commission. SliceWP writes this back
  /// onto an existing visit, so conversions are re-synced separately from new
  /// visits — a date watermark alone would never revisit the older row.
  slicewpCommissionId Int?
  occurredAt          DateTime
  syncedAt            DateTime  @default(now())

  @@index([affiliateId, occurredAt])
  @@index([occurredAt])
  /// Looked up per ledger entry to tell a sale traced to a click from one that
  /// arrived without one, so it has to be indexed on its own.
  @@index([slicewpCommissionId])
}

/// A marketing asset affiliates can use. Store-wide, not per-affiliate: the
/// tracking link is built per affiliate at display time from `landingUrl`.
model Creative {
  id          String   @id @default(cuid())
  slicewpId   Int      @unique
  name        String
  description String?
  /// image | text | long_text
  type        String
  imageUrl    String?
  altText     String?
  text        String?
  landingUrl  String?
  /// active | inactive. Only active ones are shown to affiliates, but inactive
  /// ones are mirrored too so an admin can see the full set.
  status      String
  dateCreated DateTime
  syncedAt    DateTime @default(now())

  @@index([status])
}

/// A discount code attached to an affiliate, so purchases using it are
/// credited to them without a referral link.
///
/// Coupons live in the commerce plugin (WooCommerce posts here), not in
/// SliceWP, and each integration reports its own shape through a filter. Only
/// the fields common to all of them are given columns.
model AffiliateCoupon {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  /// Which commerce integration owns it — "woo", "edd", …
  origin      String
  /// The coupon's id within that integration; only unique alongside `origin`.
  externalId  Int
  code        String
  /// Preformatted by SliceWP ("10%", "$5.00"). The underlying discount type and
  /// raw amount are not exposed separately, so this is a display string, not a
  /// number to calculate with.
  amount      String?
  /// Use counts keyed by commission status: paid / unpaid / pending / rejected.
  uses        Json?
  syncedAt    DateTime  @default(now())

  @@unique([origin, externalId])
  @@index([affiliateId])
}

model Commission {
  id              String           @id @default(cuid())
  slicewpId       Int              @unique
  affiliateId     String
  affiliate       Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  wooOrderId      Int?
  amount          Decimal          @db.Decimal(12, 2)
  orderRevenue    Decimal?         @db.Decimal(12, 2)
  status          CommissionStatus @default(UNPAID)
  type            String?
  origin          String?
  parentSlicewpId Int?
  visitSlicewpId    Int?
  customerSlicewpId Int?
  winningRule       String?
  attributionAudit  Json?
  dateCreated     DateTime
  syncedAt        DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ledgerEntries   LedgerEntry[]

  @@index([customerSlicewpId])
}

/// Woo order attribution snapshot — one row per order, shared by line commissions.
model OrderAttribution {
  id                         String   @id @default(cuid())
  wooOrderId                 Int      @unique
  referrerAffiliateSlicewpId Int?
  referrerVisitSlicewpId     Int?
  couponCodes                String[]
  sessionEntryHost           String?
  checkoutChannel            String?
  attributionAudit           Json?
  syncedAt                   DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([wooOrderId])
}

model Team {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  sponsorAffiliateId String
  sponsorAffiliate   Affiliate @relation("SponsorTeams", fields: [sponsorAffiliateId], references: [id], onDelete: Cascade)
  active             Boolean   @default(true)
  /**
   * Set to "downline" for teams auto-created from SliceWP parent_id tree
   */
  slicewpKey         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  dealRules     DealRule[]
  payoutBatches PayoutBatch[]

  @@unique([sponsorAffiliateId, slicewpKey])
  @@index([sponsorAffiliateId])
}

model DealRule {
  id                        String         @id @default(cuid())
  name                      String
  type                      DealRuleType
  sponsorAffiliateId        String
  sponsorAffiliate          Affiliate      @relation("SponsorRules", fields: [sponsorAffiliateId], references: [id], onDelete: Cascade)
  sourceAffiliateId         String?
  sourceAffiliate           Affiliate?     @relation("SourceRules", fields: [sourceAffiliateId], references: [id], onDelete: Cascade)
  teamId                    String?
  team                      Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ratePercent               Decimal        @db.Decimal(5, 2)
  basis                     DealBasis
  milestoneRevenueThreshold Decimal?       @db.Decimal(12, 2)
  schedule                  PayoutSchedule @default(WEEKLY_MONDAY)
  active                    Boolean        @default(true)
  metadata                  Json?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  ledgerEntries             LedgerEntry[]

  @@index([teamId])
}

model LedgerEntry {
  id                  String           @id @default(cuid())
  affiliateId         String
  affiliate           Affiliate        @relation("AffiliateLedger", fields: [affiliateId], references: [id], onDelete: Cascade)
  type                LedgerEntryType
  amount              Decimal          @db.Decimal(12, 2)
  status              CommissionStatus @default(UNPAID)
  description         String?
  wooOrderId          Int?
  orderRevenue        Decimal?         @db.Decimal(12, 2)
  sourceAffiliateId   String?
  sourceAffiliate     Affiliate?       @relation("SourceAffiliateLedger", fields: [sourceAffiliateId], references: [id], onDelete: SetNull)
  sourceCommissionId  String?
  sourceCommission    Commission?      @relation(fields: [sourceCommissionId], references: [id], onDelete: SetNull)
  dealRuleId          String?
  dealRule            DealRule?        @relation(fields: [dealRuleId], references: [id], onDelete: SetNull)
  slicewpCommissionId Int?
  payoutBatchId       String?
  payoutBatch         PayoutBatch?     @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  payoutWeek          DateTime?
  paidAt              DateTime?
  /// When the underlying sale happened. createdAt is when sync wrote the row,
  /// which is meaningless to an affiliate reading their ledger.
  occurredAt          DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([affiliateId, status])
  @@index([affiliateId, occurredAt])
  @@index([sourceAffiliateId])
  @@index([wooOrderId])
}

model PayoutBatch {
  id                 String            @id @default(cuid())
  label              String
  periodStart        DateTime
  periodEnd          DateTime
  status             PayoutBatchStatus @default(DRAFT)
  sponsorAffiliateId String?
  teamId             String?
  team               Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  processedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  items              PayoutBatchItem[]
  ledgerEntries      LedgerEntry[]

  /// Defaults to NOT_REQUIRED so the batches that already exist — all settled
  /// by hand before write-back — do not read as a backlog the moment this
  /// column appears. Batches that need settling set PENDING explicitly.
  writeBackStatus      PayoutWriteBackStatus @default(NOT_REQUIRED)
  /// The SliceWP payment this batch produced. Unique because the batch id is
  /// the idempotency key, so two batches sharing a payment is a bug.
  slicewpPaymentId     Int?                  @unique
  /// What SliceWP was actually told to pay. Smaller than the batch total
  /// whenever overrides are included, since only DIRECT entries map to a
  /// SliceWP commission. Reconciliation compares against this, not the total.
  settledAmount        Decimal?              @db.Decimal(12, 2)
  settledAt            DateTime?
  writeBackError       String?
  writeBackAttempts    Int                   @default(0)
  writeBackAttemptedAt DateTime?

  @@index([teamId])
  @@index([sponsorAffiliateId])
  @@index([writeBackStatus])
}

model PayoutBatchItem {
  id          String      @id @default(cuid())
  batchId     String
  batch       PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  affiliateId String
  affiliate   Affiliate   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  totalAmount Decimal     @db.Decimal(12, 2)
  entryCount  Int

  @@unique([batchId, affiliateId])
}

/// A payout recorded in SliceWP rather than in this app. SliceWP's own
/// "payout" is just the admin-side container; its `payments` rows are the
/// per-affiliate receipts, which is what an affiliate's history is made of.
model SlicewpPayment {
  id               String    @id @default(cuid())
  slicewpPaymentId Int       @unique
  slicewpPayoutId  Int?
  affiliateId      String
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount           Decimal   @db.Decimal(12, 2)
  currency         String?
  status           String
  payoutMethod     String?
  /// SliceWP stores these comma-separated on the payment row. Kept so the
  /// receipt can be itemised from the commissions we already sync.
  commissionIds    Int[]
  dateCreated      DateTime
  dateModified     DateTime?
  syncedAt         DateTime  @default(now())

  @@index([affiliateId, dateCreated])
  @@index([slicewpPayoutId])
}

model Settings {
  id                             String    @id @default("default")
  wcStoreUrlEncrypted            String?
  wcConsumerKeyEncrypted         String?
  wcConsumerSecretEncrypted      String?
  slicewpConsumerKeyEncrypted    String?
  slicewpConsumerSecretEncrypted String?
  lastAffiliateSyncAt            DateTime?
  lastCommissionSyncAt           DateTime?
  /// Watermark for incremental visit sync: the `date_created` of the newest
  /// visit already mirrored. Kept as the store's own timestamp rather than
  /// "when we last synced", so a slow or failed run cannot skip a window.
  lastVisitSyncedThrough         DateTime?
  syncRunning                    Boolean   @default(false)
  syncStep                       String?
  syncStartedAt                  DateTime?
  lastSyncError                  String?
  lastSyncResult                 Json?
  updatedAt                      DateTime  @updatedAt
}

model SyncLog {
  id        String   @id @default(cuid())
  type      String
  status    String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())
}
